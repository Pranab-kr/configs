{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/fastfetch-emblem.png",
    "width": 30,
    "height": 14,
    "padding": {
      "top": 5,
      "right": 5,
      "left": 3
    },
    "color": {
      "1": "#ff63c5",
      "2": "#ed63c5"
    }
  },
  "display": {
    "color": {
      "keys": "#ffb1c5",
      "title": "#edb9c5",
      "separator": "#8f8770"
    },
    "key": {
      "width": 9
    },
    "separator": "  ",
    "percent": {
      "type": 9,
      "color": {
        "green": "#ffb872",
        "yellow": "#ffb1c5",
        "red": "#ffb4ab"
      }
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{#1;title}{user-name}{#}{#separator} @ {#}{#1;title}{host-name}{#}"
    },
    // {
    //   "type": "custom",
    //   "format": "{#keys}■{#} {#separator}RYOKU · 力 · a hand-built Arch desktop{#}"
    // },
    "break",
    {
      "type": "custom",
      "format": "{#keys}──{#} {#1;title}VITALS{#} {#38;2;58;46;36}──────────────────────────{#}"
    },
    {
      "type": "cpu",
      "key": "CPU"
    },
    {
      "type": "gpu",
      "key": "GPU",
      "detectionMethod": "pci"
    },
    {
      "type": "memory",
      "key": "MEMORY"
    },
    {
      "type": "disk",
      "key": "DISK"
    },
    "break",
    {
      "type": "custom",
      "format": "{#keys}──{#} {#1;title}SYSTEM{#} {#38;2;58;46;36}──────────────────────────{#}"
    },
    {
      "type": "command",
      "key": "OS",
      "text": "command -v ryoku >/dev/null 2>&1 && echo \"Ryoku $(ryoku version --pretty 2>/dev/null || echo dev)\" || (source /etc/os-release 2>/dev/null && echo \"$PRETTY_NAME\") || echo \"Linux\""
    },
    {
      "type": "command",
      "key": "BRANCH",
      "text": "ryoku version --branch 2>/dev/null || echo \"stable\""
    },
    {
      "type": "kernel",
      "key": "KERNEL"
    },
    {
      "type": "wm",
      "key": "WM",
      "format": "{pretty-name}"
    },
    {
      "type": "shell",
      "key": "SHELL",
      "format": "{exe-name}"
    },
    {
      "type": "packages",
      "key": "PKGS"
    },
    "break",
    {
      "type": "custom",
      "format": "{#keys}──{#} {#1;title}SESSION{#} {#38;2;58;46;36}─────────────────────────{#}"
    },
    {
      "type": "uptime",
      "key": "UPTIME"
    },
    {
      "type": "command",
      "key": "AGE",
      "text": "echo $(( ($(date +%s) - $(stat -c %W / 2>/dev/null || stat -c %Y /)) / 86400 )) days"
    },
    {
      "type": "terminal",
      "key": "TERM",
      "format": "{exe-name}"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 2
    },
    "break"
  ]
}
